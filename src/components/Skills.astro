---
import { skills } from "../config";
---

<section id="skills">
  <div class="container">
    <p class="section-label">02 · Skills</p>
    <h2 class="section-title">What I work with</h2>
    <div class="grid skills">
      {skills.map((s) => (
        <div class="card reveal">
          <h3>{s.group}</h3>
          <ul>
            {s.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  h3 { font-size: 1.05rem; margin-bottom: 16px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  li {
    font-size: 0.9rem;
    padding: 6px 12px;
    border-radius: 8px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
  }
</style>
